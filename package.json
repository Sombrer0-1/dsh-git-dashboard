{
  "name": "dsh-git-dashboard",
  "version": "0.1.0",
  "description": "Read-only Git workspace dashboard for the dsh web profile (out-of-tree bundle)",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Sombrer0-1/dsh-git-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/Sombrer0-1/dsh-git-dashboard/issues"
  },
  "homepage": "https://github.com/Sombrer0-1/dsh-git-dashboard#readme",
  "keywords": [
    "deepseek",
    "dsh",
    "git",
    "dashboard",
    "cordis"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./lib/types/remote.d.ts",
      "default": "./lib/remote.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "scripts/link-runtime-deps.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
